PORT=5050
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=school_portal
DB_USER=root
DB_PASSWORD=
DB_POOL_LIMIT=10
# Database-writing scripts refuse remote hosts by default. For an approved,
# isolated pilot run only, set SBAA_PILOT_TEST=true and DB_NAME=sbaa_pilot_test.
# Remote pilot writes additionally require SBAA_PILOT_ALLOW_REMOTE=true,
# DB_SSL_CA, and a MySQL user whose SHOW GRANTS is scoped to sbaa_pilot_test.*.
# Never set these pilot switches on Render or in a production .env.
# SBAA_PILOT_TEST=true
# SBAA_PILOT_ALLOW_REMOTE=true
# Production Aiven: set DB_SSL_CA privately to the complete PEM certificate.
# DB_SSL_CA=-----BEGIN CERTIFICATE-----...-----END CERTIFICATE-----
CLIENT_URL=http://localhost:5173
APP_PUBLIC_URL=http://localhost:5173
MAIL_MODE=development
# First-time fictional local seed only; never set on a production server.
# DEV_SEED_PASSWORD=
# For isolated integration tests only: password of the fictional seed fixtures.
# TEST_SEED_PASSWORD=
# Production-only: set NODE_ENV=production and generate a new random CSRF_SECRET
# locally (at least 32 characters). Never commit either secret or the filled .env.
# SESSION_TRANSPORT=cookie
# CSRF_SECRET=
# PROXY_SHARED_SECRET=
# Local development keeps private files on disk. Render Free requires Supabase mode.
PRIVATE_STORAGE_MODE=filesystem
# UPLOAD_DIR=/absolute/private/path
# Render: create a PRIVATE Supabase Storage bucket named sbaa-private-uploads.
# Keep these values in Render private environment variables only, never VITE_*.
# PRIVATE_STORAGE_MODE=supabase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_BUCKET=sbaa-private-uploads
# RUN_REMINDER_SCHEDULER=false
# For Gmail delivery: MAIL_MODE=smtp, smtp.gmail.com:465, implicit TLS.
# Fill SMTP_USER with the authorized sender's full Gmail address and SMTP_PASSWORD
# with that account's Google App Password. Do not use your normal Gmail password.
# MAIL_FROM must be: SBAA School Portal <the-same-authorized-address>
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=SBAA School Portal <sender@gmail.com>
# Render Free blocks SMTP ports. For a verified-domain HTTPS provider instead:
# MAIL_MODE=resend
# RESEND_API_KEY=
# MAIL_FROM=SBAA School Portal <sender@verified-school-domain.example>
# Render Free HTTPS alternative (requires Brevo transactional activation and
# sender verification/authorization; keep the API key only on the server):
# MAIL_MODE=brevo
# BREVO_API_KEY=
# MAIL_FROM=SBAA System <sbaa.chcci.admin@gmail.com>
# Separate auth limits per IP in each 15-minute window (in-memory, restart clears):
AUTH_LOGIN_LIMIT=20
AUTH_REGISTER_LIMIT=20
AUTH_FORGOT_LIMIT=10
AUTH_VALIDATE_LIMIT=60
AUTH_RESET_LIMIT=20
